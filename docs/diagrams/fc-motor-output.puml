@startuml
' rfs-diagram: fc-motor-output
skinparam componentStyle rectangle
skinparam shadowing false

component "飞控算法\nupdate()" as FCU
component "板级接口\nwrite_motors()" as WM
component "电调输出 EscOutput\n映射 + 编码（core/esc）" as EO
component "仿真板 SimBoard\n把 0~1 原样发给仿真器" as SB
component "电调总线 EscBus\n定时器 + DMA（bsp/~<board>）" as EB
component "电调 × N" as ESC
component "电机" as MOT

FCU --> WM : ActuatorOutputs，motors[i] ∈ [0, 1]，armed
WM --> EO : 真实板子
WM --> SB : 仿真
EO --> EB : EscFrame，DShot 帧或 PWM 脉宽（ns）
EB --> ESC : DShot / PWM 信号
ESC --> MOT
@enduml
