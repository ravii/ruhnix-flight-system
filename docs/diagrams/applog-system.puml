@startuml
' rfs-diagram: applog-system
skinparam componentStyle rectangle
skinparam shadowing false

agent "camera / depth" as CAM
agent "GNSS / VIO" as GNSS

rectangle "AP: companion computer, ARM64 Linux" {
  component "perception" as PER
  component "localization" as LOC
  component "app" as APP
  component "fc_link" as LINK
  queue "message bus\nnamed topics carrying rfs::common messages" as BUS
  component "log: rfs_record" as REC
}
node "flight controller" as FC
folder "run_<date>_<time>/\n.mcap + .log" as RUN

CAM --> PER
GNSS --> LOC
PER <--> BUS
LOC <--> BUS
APP <--> BUS
LINK <--> BUS
LINK <--> FC : UART
BUS --> REC : subscribes to every topic
REC --> RUN
@enduml
