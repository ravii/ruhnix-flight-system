@startuml
' rfs-diagram: applog-system
skinparam componentStyle rectangle
skinparam shadowing false

agent "相机 / 深度相机" as CAM
agent "GNSS / VIO" as GNSS

rectangle "机载计算机（ARM64 Linux）" {
  component "感知" as PER
  component "定位" as LOC
  component "智能应用 app" as APP
  component "飞控链路 fc_link" as LINK
  queue "消息总线\n按 topic 发布和订阅" as BUS
  component "录制 rfs_record" as REC
}
node "飞控" as FC
folder "run_<date>_<time>/\n.mcap 和 .log" as RUN

CAM --> PER
GNSS --> LOC
PER <--> BUS
LOC <--> BUS
APP <--> BUS
LINK <--> BUS
LINK <--> FC : UART
BUS --> REC : 订阅全部 topic
REC --> RUN
@enduml
