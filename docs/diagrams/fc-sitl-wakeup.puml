@startuml
' rfs-diagram: fc-sitl-wakeup
skinparam shadowing false
participant "仿真器\nrfs_sim（UdpLink）" as SIM
box "飞控固件（SITL）"
  participant "空闲任务" as IDLE
  participant "控制任务" as CTRL
end box

note over IDLE : poll() 等待 socket\n相当于 MCU 上的 WFI
SIM -> IDLE : 传感器数据 SIM_SENSORS（UDP）
IDLE -> CTRL : xTaskNotifyGive()\n相当于 IMU 中断
activate CTRL
CTRL -> CTRL : wait_imu() 返回\n飞控算法 update()
CTRL -> SIM : 电机输出 SIM_ACTUATORS（write_motors()）
deactivate CTRL
@enduml
