@startuml
' rfs-diagram: applog-replay
skinparam componentStyle rectangle
skinparam shadowing false

file "recording.mcap" as IN
component "回放进程 rfs_replay\n速度 1x / 最快 / 单步\ntopic 过滤" as RP
component "被测算法\n感知、定位、智能应用" as UT
component "录制进程 rfs_record" as REC
file "new.mcap" as OUT

IN --> RP
RP --> UT : 录制的传感器 topic\n/clock（录制时间）
UT --> REC : 新结果
REC --> OUT
OUT ..> IN : 和原始录制比对
@enduml
