{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/claude-format-hook.sh\"",
            "timeout": 30,
            "statusMessage": "clang-format"
          }
        ]
      }
    ]
  }
}
