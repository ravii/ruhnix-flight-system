@startuml
' rfs-diagram: applog-app-internals
skinparam componentStyle rectangle
skinparam shadowing false

left to right direction
queue "/localization/pose" as T1
queue "/perception/obstacles" as T2
queue "/fc/attitude, /fc/status" as T3
component "世界模型\n融合后的状态" as WM
component "行为管理\n状态机" as BM
component "安全限制\n限速、电子围栏" as SL
queue "/app/setpoint, /app/command" as OUT
queue "/app/plan" as PLAN

T1 --> WM
T2 --> WM
T3 --> WM
WM --> BM
BM --> SL : 指令
BM --> PLAN : 规划和状态
SL --> OUT
@enduml
